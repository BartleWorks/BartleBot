  "template_meta": {
    "blurb": "Farms a boss for spellements while level-scaled: applies level scaling to selected players when needed, enters the boss's dungeon, defeats the boss, exits, and repeats.\n\nIf the entrance zone isn't in the zone list, choose the nearest zone that is, and add navigation nodes from there to the entrance. Set the Quicksell keep list from the boss's drops. The Scales of Knowledge used for level scaling default to the ones in the final dungeon of the world that the boss is in. Choose one by hand for level bands or worlds with multiple options.",
    "setup": [
      {
        "text": "Choose the zone the boss's dungeon entrance is in",
        "targets": [
          {
            "region": "t_sync_players_1",
            "input": "state_2.zone"
          }
        ]
      },
      {
        "text": "Record entering the boss's dungeon",
        "targets": [
          {
            "state": "t_10",
            "param": "from_zone"
          },
          {
            "state": "t_10",
            "param": "dungeon_zone"
          },
          {
            "state": "t_10",
            "param": "sigil_xyz"
          },
          {
            "state": "t_10",
            "param": "reset_xyz"
          }
        ]
      },
      {
        "text": "Record the boss's enemy ID",
        "targets": [
          {
            "state": "t_11",
            "param": "enemy"
          }
        ]
      },
      {
        "text": "Import the boss's drops from its wiki page",
        "targets": [
          {
            "field": "drops"
          }
        ]
      },
      {
        "text": "Record exiting the dungeon",
        "targets": [
          {
            "state": "t_13",
            "param": "from_zone"
          },
          {
            "state": "t_13",
            "param": "to_zone"
          },
          {
            "state": "t_13",
            "param": "xyz"
          },
          {
            "state": "t_13",
            "param": "reset_xyz"
          }
        ]
      }
    ]
  }
