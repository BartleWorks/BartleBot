  "template_meta": {
    "blurb": "Farms a whole dungeon: marks the entrance, enters, runs the nodes you add, recalls out, and repeats.\n\nAdd the nodes that clear the dungeon between Enter dungeon and Recall to the entrance. If the entrance zone isn't in the zone list, choose the nearest zone that is, and add navigation nodes from there to the entrance. Set the Quicksell keep list from the dungeon's drops.",
    "setup": [
      {
        "text": "Choose the zone the dungeon entrance is in",
        "targets": [
          {
            "region": "t_sync_players_1",
            "input": "state_2.zone"
          },
          {
            "state": "t_6",
            "param": "zone"
          }
        ]
      },
      {
        "text": "Fill in the world hub zone",
        "targets": [
          {
            "state": "t_8",
            "param": "zone"
          }
        ]
      },
      {
        "text": "Record entering the dungeon",
        "targets": [
          {
            "state": "t_3",
            "param": "from_zone"
          },
          {
            "state": "t_3",
            "param": "dungeon_zone"
          },
          {
            "state": "t_3",
            "param": "sigil_xyz"
          },
          {
            "state": "t_3",
            "param": "reset_xyz"
          }
        ]
      },
      {
        "text": "Choose where players mark and recall to: near the sigil, but where its prompt doesn't show",
        "targets": [
          {
            "state": "t_6",
            "param": "xyz"
          }
        ]
      },
      {
        "text": "Import the drops of the dungeon's fights from their wiki pages",
        "targets": [
