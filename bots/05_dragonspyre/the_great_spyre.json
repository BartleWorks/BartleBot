  "options": [
    {
      "name": "Safety Delay",
      "type": "float",
      "default": 3,
      "description": "Minimum seconds to watch for dialog windows after triggering an interaction before concluding that none will open."
    },
    {
      "name": "Level Scaling Players",
      "type": "player_list",
      "default": [
        2,
        3,
        4
      ],
      "description": "1-based player numbers to check/apply level scaling (e.g. '2, 3'). Empty = no players (no scaling performed). Shared by check_level_scaling and apply_level_scaling."
    },
    {
      "name": "Default Combat Order",
      "type": "int_list",
      "default": [
        2,
        1
      ],
      "description": "Default order clients enter combat (e.g. '2, 1' sends client 2 first). Empty = all clients enter simultaneously. Can be overridden per node via Option Overrides."
    },
    {
      "name": "Defeat Gurtok Firebender",
      "type": "bool",
      "default": false,
      "description": "Whether or not to defeat the Gurtok Firebender, which drops level 50 rings"
    },
    {
      "name": "Defeat Gurtok Piercer",
      "type": "bool",
      "default": true,
      "description": "Whether or not to defeat the Gurtok Piercer, which drops level 50 athames"
    }
  ],
